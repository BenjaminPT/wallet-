{
  "name": "noir-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "Noir Wallet \u2014 non-custodial multi-chain PWA wallet (EVM, Bitcoin, Solana, TON, Tron)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/derive.test.mjs test/guard.test.mjs test/accounts.test.mjs test/fees.test.mjs",
    "serve": "node server/server.mjs",
    "shots": "node test/shots.mjs",
    "test:live": "node --test test/live.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@scure/btc-signer": "1.8.1",
    "@solana/web3.js": "1.99.0",
    "@ton/core": "0.62.1",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "15.4.0",
    "buffer": "6.0.3",
    "ethers": "6.17.0",
    "htm": "3.1.1",
    "jsqr": "1.4.0",
    "preact": "10.29.8",
    "qrcode-generator": "1.5.2"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "playwright": "1.65.0"
  }
}
